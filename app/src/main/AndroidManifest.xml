<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.zing.zalo" />
        <intent><action android:name="android.intent.action.CREATE_SHORTCUT" /></intent>
    </queries>
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:allowBackup="false"
        android:label="Zalo Chat Lab"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ShortcutProbeActivity" android:exported="false" />
        <activity android:name=".BatchImportActivity" android:exported="false" />
        <activity android:name=".ContactsProbeActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
